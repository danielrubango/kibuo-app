<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: only the encrypted database and its key locked by the
     recovery code are copied, and only when KibuoBackupAgent allows it
     (a recovery code exists and « Laisser Android copier Kibuo » is on).
     The phone's keys, PIN and settings stay behind (ADR 0010). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="kibuo.db" />
        <include domain="file" path="kibuo-key.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="kibuo.db" />
        <include domain="file" path="kibuo-key.json" />
    </device-transfer>
</data-extraction-rules>
