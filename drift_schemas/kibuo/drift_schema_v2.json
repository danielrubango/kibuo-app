      "name": "currencies",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"currencies\" (\"id\" TEXT NOT NULL, \"version\" INTEGER NOT NULL, \"device_id\" TEXT NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"code\" TEXT NOT NULL, \"uses_decimals\" INTEGER NOT NULL CHECK (\"uses_decimals\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
