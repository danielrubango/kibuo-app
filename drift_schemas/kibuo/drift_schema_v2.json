      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exchange_rates\" (\"id\" TEXT NOT NULL, \"version\" INTEGER NOT NULL, \"device_id\" TEXT NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"base\" TEXT NOT NULL, \"quote\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"set_on\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
